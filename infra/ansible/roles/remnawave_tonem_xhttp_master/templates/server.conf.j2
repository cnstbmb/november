server {
    listen 80;
    listen [::]:80;
    server_name {{ remnawave_tonem_xhttp_domain }};
    access_log off;
    error_log /dev/null crit;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/tonem-xhttp-acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ remnawave_tonem_xhttp_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ remnawave_tonem_xhttp_cert_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ remnawave_tonem_xhttp_cert_name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    server_tokens off;
    access_log off;
    error_log /dev/null crit;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    resolver 127.0.0.11 valid=30s ipv6=off;

    include /etc/nginx/tonem-xhttp/locations/{{ remnawave_tonem_xhttp_domain }}.conf;

    location = /client-telemetry {
        return 404;
    }

    location ^~ /analytics/ {
        return 404;
    }

    location = /analytics-config.js {
        default_type application/javascript;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        return 200 'window.__TONEM_ANALYTICS__ = { enabled: false };';
    }

    location / {
        set $tonem_xhttp_web_upstream {{ remnawave_tonem_xhttp_upstream }};
        proxy_pass http://$tonem_xhttp_web_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
        proxy_connect_timeout 5s;
        proxy_next_upstream off;
    }
}
