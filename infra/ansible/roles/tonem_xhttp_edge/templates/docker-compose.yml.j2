services:
  landing:
    image: "${TONEM_XHTTP_IMAGE:-{{ tonem_xhttp_edge_image }}}"
    container_name: "{{ tonem_xhttp_edge_container_name }}"
    restart: unless-stopped
    network_mode: host
    volumes:
      - "{{ tonem_xhttp_edge_nginx_file }}:/etc/nginx/conf.d/default.conf:ro"
      - "{{ tonem_xhttp_edge_analytics_config_file }}:/usr/share/nginx/html/analytics-config.js:ro"
      - "{{ tonem_xhttp_edge_acme_dir }}:/var/www/tonem-xhttp-acme:ro"
      - "/etc/letsencrypt:/etc/letsencrypt:ro"
    logging:
      driver: json-file
      options:
        max-size: "5m"
        max-file: "3"
