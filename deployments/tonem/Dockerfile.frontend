# syntax=docker/dockerfile:1

# ── Build stage ──────────────────────────────────────────────────────────────
# Context: repository root (npm workspaces hoist deps to the root node_modules).
# Mirrors apps/tonem-server/Dockerfile so the whole tonem stack builds the same way.
FROM node:20-alpine AS build
WORKDIR /repo

# Copy workspace manifests first for layer caching.
COPY package.json package-lock.json ./
COPY apps/tonem/package.json apps/tonem/package.json

# Install the full workspace (hoists @angular/* + cli to the root node_modules).
RUN npm ci

# Copy the tonem sources and build the production bundle.
COPY apps/tonem apps/tonem
RUN npm run build:tonem
# Angular 17+ emits the static app to apps/tonem/dist/tonem/browser.

# ── Runtime stage ────────────────────────────────────────────────────────────
FROM nginx:mainline-alpine AS runtime

# Static SPA config (SPA fallback + cache headers + gzip).
COPY deployments/tonem/nginx/tonem.conf /etc/nginx/conf.d/default.conf

# Built static files.
COPY --from=build /repo/apps/tonem/dist/tonem/browser /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
