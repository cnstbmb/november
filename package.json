{
  "name": "november",
  "version": "0.0.1",
  "description": "monorepo",
  "private": true,
  "main": "null",
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "apps/tonem",
    "apps/tonem-server",
    "packages/algorithms"
  ],
  "scripts": {
    "test:algorithms": "npm --workspace @november/algorithms test",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:backend": "npm --workspace november-server run build",
    "build:backend:docker": "npm --workspace november-server run build:docker:prod",
    "start:backend": "npm --workspace november-server run start",
    "lint:fix:backend": "npm --workspace november-server run lint:fix",
    "build:frontend": "npm --workspace frontend run build",
    "build:tonem": "npm --workspace tonem run build",
    "start:tonem": "npm --workspace tonem run start",
    "build:tonem-server": "npm --workspace tonem-server run build",
    "start:tonem-server": "npm --workspace tonem-server run start",
    "test:tonem-server": "npm --workspace tonem-server run test",
    "start:frontend": "npm --workspace frontend run start",
    "build:frontend:docker": "npm --workspace frontend run build:docker:prod",
    "watch:frontend": "npm --workspace frontend run watch",
    "lint:fix:frontend": "npm --workspace frontend run lint:fix",
    "prepare": "husky install",
    "build:prod": "tools/scripts/build_prod.sh",
    "build:prod:yc": "tools/scripts/build_prod_yc.sh",
    "build:prod:local:mac": "tools/scripts/build_prod_local_mac.sh",
    "build:tonem:prod": "tools/scripts/build_tonem_prod.sh",
    "deploy:tonem": "tools/ansible/deploy_tonem.sh",
    "deploy:tonem:check": "tools/ansible/deploy_tonem.sh --check",
    "ansible:tonem-analytics": "tools/ansible/run_prod_private.sh --playbook tonem-analytics --limit master",
    "ansible:tonem-analytics:check": "tools/ansible/run_prod_private.sh --playbook tonem-analytics --limit master --check",
    "ansible:bootstrap": "tools/ansible/bootstrap_private_vars.sh",
    "ansible:node-env": "tools/ansible/bootstrap_remnawave_node_env.sh",
    "ansible:topology": "tools/ansible/bootstrap_remnawave_topology.sh",
    "ansible:subscription-page": "tools/ansible/bootstrap_remnawave_subscription_page.sh",
    "remnawave:audit:sni-canary": "REMNAWAVE_MASTER_CANARY_PORT=4443 tools/ansible/remnawave/audit_master_sni_canary.sh",
    "remnawave:audit:sni-443": "REMNAWAVE_MASTER_SNI_PORT=443 tools/ansible/remnawave/audit_master_sni_canary.sh",
    "remnawave:audit:self-steal": "tools/ansible/remnawave/audit_self_steal.sh",
    "remnawave:apply:torrent-blocker": "node tools/ansible/remnawave/apply_torrent_blocker.mjs",
    "remnawave:apply:moscow-home-wifi": "node tools/ansible/remnawave/apply_moscow_home_wifi_9443.mjs",
    "remnawave:apply:moscow-hysteria2": "node tools/ansible/remnawave/apply_moscow_hysteria2.mjs",
    "remnawave:apply:moscow-xhttp-stream-one": "node tools/ansible/remnawave/apply_moscow_xhttp_stream_one.mjs",
    "remnawave:monitoring-home:check": "node tools/ansible/remnawave/fix_monitoring_home_channel.mjs",
    "remnawave:monitoring-home:apply": "node tools/ansible/remnawave/fix_monitoring_home_channel.mjs --apply",
    "remnawave:rotate:credentials:check": "node tools/ansible/remnawave/rotate_compromised_credentials.mjs",
    "remnawave:rotate:credentials": "node tools/ansible/remnawave/rotate_compromised_credentials.mjs --apply",
    "ansible:warmup": "tools/ansible/warmup_prod_private.sh",
    "ansible:run": "tools/ansible/run_prod_private.sh",
    "ansible:run:check": "tools/ansible/run_prod_private.sh --check",
    "ansible:run:menu": "tools/ansible/run_prod_private.sh --menu",
    "ansible:base": "tools/ansible/run_prod_private.sh --playbook base",
    "ansible:base:check": "tools/ansible/run_prod_private.sh --playbook base --check",
    "ansible:firewall": "tools/ansible/run_prod_private.sh --playbook firewall",
    "ansible:firewall:check": "tools/ansible/run_prod_private.sh --playbook firewall --check",
    "ansible:master": "tools/ansible/run_prod_private.sh --playbook master",
    "ansible:master:fresh": "npm run ansible:base && npm run ansible:master",
    "ansible:master:check": "tools/ansible/run_prod_private.sh --playbook master --check",
    "ansible:workers": "tools/ansible/run_prod_private.sh --playbook workers --ask-become-pass",
    "ansible:workers:check": "tools/ansible/run_prod_private.sh --playbook workers --check --ask-become-pass",
    "ansible:stubby": "tools/ansible/run_prod_private.sh --playbook workers --tags stubby --ask-become-pass",
    "ansible:stubby:check": "tools/ansible/run_prod_private.sh --playbook workers --tags stubby --check --ask-become-pass",
    "ansible:stremio": "tools/ansible/run_prod_private.sh --playbook stremio",
    "ansible:stremio:check": "tools/ansible/run_prod_private.sh --playbook stremio --check",
    "ansible:site": "tools/ansible/run_prod_private.sh --playbook site",
    "ansible:site:check": "tools/ansible/run_prod_private.sh --playbook site --check",
    "ansible:monitoring": "tools/ansible/run_prod_private.sh --playbook monitoring",
    "ansible:monitoring:check": "tools/ansible/run_prod_private.sh --playbook monitoring --check",
    "ansible:monitoring-alerting": "tools/ansible/run_prod_private.sh --playbook monitoring --limit master --tags monitoring_alerting",
    "ansible:monitoring-alerting:check": "tools/ansible/run_prod_private.sh --playbook monitoring --limit master --tags monitoring_alerting --check",
    "ansible:monitoring-postgres-exporter": "tools/ansible/run_prod_private.sh --playbook monitoring --limit master --tags monitoring_postgres_exporter",
    "ansible:monitoring-postgres-exporter:check": "tools/ansible/run_prod_private.sh --playbook monitoring --limit master --tags monitoring_postgres_exporter --check",
    "ansible:monitoring-public-grafana-dirs": "tools/ansible/run_prod_private.sh --playbook monitoring --limit master --tags monitoring_public_grafana_dirs",
    "ansible:monitoring-public-grafana-dirs:check": "tools/ansible/run_prod_private.sh --playbook monitoring --limit master --tags monitoring_public_grafana_dirs --check",
    "ansible:monitoring-hardening": "tools/ansible/run_prod_private.sh --playbook monitoring --limit master --tags monitoring_port_hardening,monitoring_email_disabled",
    "ansible:monitoring-hardening:check": "tools/ansible/run_prod_private.sh --playbook monitoring --limit master --tags monitoring_port_hardening,monitoring_email_disabled --check",
    "ansible:monitoring-telegram-proxy": "tools/ansible/run_prod_private.sh --playbook monitoring --limit master --tags monitoring_telegram_proxy",
    "ansible:monitoring-telegram-proxy:check": "tools/ansible/run_prod_private.sh --playbook monitoring --limit master --tags monitoring_telegram_proxy --check",
    "ansible:monitoring-telegram-credentials": "tools/ansible/run_prod_private.sh --playbook monitoring --limit master --tags monitoring_telegram_credentials",
    "ansible:monitoring-telegram-credentials:check": "tools/ansible/run_prod_private.sh --playbook monitoring --limit master --tags monitoring_telegram_credentials --check",
    "ansible:monitoring-agent": "tools/ansible/run_prod_private.sh --playbook monitoring-agent",
    "ansible:monitoring-agent:check": "tools/ansible/run_prod_private.sh --playbook monitoring-agent --check",
    "ansible:backups": "tools/ansible/run_prod_private.sh --playbook backups",
    "ansible:backups:check": "tools/ansible/run_prod_private.sh --playbook backups --check",
    "ansible:remnawave-panel": "tools/ansible/run_prod_private.sh --playbook remnawave-panel",
    "ansible:remnawave-panel:check": "tools/ansible/run_prod_private.sh --playbook remnawave-panel --check",
    "ansible:remnashop": "tools/ansible/run_prod_private.sh --playbook remnashop",
    "ansible:remnashop:check": "tools/ansible/run_prod_private.sh --playbook remnashop --check",
    "ansible:adguard-home": "tools/ansible/run_prod_private.sh --playbook adguard-home",
    "ansible:adguard-home:check": "tools/ansible/run_prod_private.sh --playbook adguard-home --check",
    "ansible:migration:prepare": "tools/ansible/run_prod_private.sh --playbook migration-prepare --limit migration",
    "ansible:migration:prepare:check": "tools/ansible/run_prod_private.sh --playbook migration-prepare --limit migration --check",
    "ansible:migration:node": "tools/ansible/run_prod_private.sh --playbook migration-node --limit migration",
    "ansible:migration:node:check": "tools/ansible/run_prod_private.sh --playbook migration-node --limit migration --check",
    "ansible:migration:socks5:allow": "tools/ansible/run_prod_private.sh --playbook migration-socks5-allow --limit workers",
    "ansible:migration:socks5:allow:check": "tools/ansible/run_prod_private.sh --playbook migration-socks5-allow --limit workers --check",
    "ansible:migration:backups": "tools/ansible/run_prod_private.sh --playbook migration-backups --limit migration",
    "ansible:migration:backups:check": "tools/ansible/run_prod_private.sh --playbook migration-backups --limit migration --check",
    "ansible:migration:restic": "tools/ansible/run_prod_private.sh --playbook migration-restic --limit migration",
    "ansible:migration:restic:check": "tools/ansible/run_prod_private.sh --playbook migration-restic --limit migration --check",
    "ansible:migration:monitoring-agents": "tools/ansible/run_prod_private.sh --playbook migration-monitoring-agents --limit migration,workers --ask-become-pass",
    "ansible:migration:monitoring-agents:check": "tools/ansible/run_prod_private.sh --playbook migration-monitoring-agents --limit migration,workers --check --ask-become-pass",
    "ansible:migration:preseed": "tools/ansible/preseed_moscow_to_vdsina.sh",
    "ansible:migration:sync-preseed-images": "tools/ansible/sync_moscow_preseed_images.sh",
    "ansible:migration:restore-preseed": "tools/ansible/restore_moscow_preseed.sh",
    "ansible:migration:dns:audit": "tools/ansible/audit_moscow_cutover_dns.sh",
    "ansible:migration:dns:cutover": "tools/ansible/switch_moscow_cutover_dns.sh cutover",
    "ansible:migration:dns:rollback": "tools/ansible/switch_moscow_cutover_dns.sh rollback",
    "adguard:sync-config": "tools/ansible/sync_adguard_home_config.sh",
    "nativeproxy:ansible": "tools/nativeproxy-ansible/run.sh",
    "nativeproxy:ansible:check": "tools/nativeproxy-ansible/run.sh --check",
    "remnashop:update": "npm run ansible:remnashop",
    "landing:up": "docker compose -f deployments/landing-lite/docker-compose.yml up -d",
    "landing:down": "docker compose -f deployments/landing-lite/docker-compose.yml down",
    "landing:logs": "docker compose -f deployments/landing-lite/docker-compose.yml logs -f",
    "landing:open": "open http://localhost",
    "pg:docker:win": "docker run --rm -P -p 127.0.0.1:5432:5432 -v %cd%/pg-data:/var/lib/postgresql/data -d -e POSTGRES_PASSWORD=\"88005553535\" --name pg postgres:alpine",
    "pg:docker:linux": "docker run --rm -P -p 127.0.0.1:5432:5432 -v $(pwd)/pg-data:/var/lib/postgresql/data -d -e POSTGRES_PASSWORD=\"88005553535\" --name pg postgres:alpine"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cnstbmb/november.git"
  },
  "author": "cnstbmb@gmail.com",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cnstbmb/november/issues"
  },
  "homepage": "https://github.com/cnstbmb/november#readme",
  "devDependencies": {
    "@types/jest": "^29.2.2",
    "husky": "^7.0.4",
    "jest": "^29.3.0",
    "ts-jest": "^29.0.3"
  }
}
