#!/bin/sh
set -eu

dump={{ (backup_tonem_prepare_dir ~ '/' ~ backup_tonem_pg_dump_filename) | quote }}
metric_dir={{ backup_tonem_textfile_dir | quote }}
container="tonem-restore-check"
metric_tmp="${metric_dir}/tonem-restore-check.prom.tmp"
metric_final="${metric_dir}/tonem-restore-check.prom"
success=0

finish() {
  docker rm -f "${container}" >/dev/null 2>&1 || true
  mkdir -p "${metric_dir}"
  {
    printf 'tonem_restore_check_last_run_status %s\n' "${success}"
    if [ "${success}" -eq 1 ]; then
      printf 'tonem_restore_check_last_success_timestamp_seconds %s\n' "$(date +%s)"
    fi
  } > "${metric_tmp}"
  mv "${metric_tmp}" "${metric_final}"
}
trap finish EXIT INT TERM

test -s "${dump}"
docker rm -f "${container}" >/dev/null 2>&1 || true
restore_password="$(openssl rand -hex 24)"
docker run -d --name "${container}" --network none \
  -e POSTGRES_USER=restorecheck \
  -e POSTGRES_PASSWORD="${restore_password}" \
  -e POSTGRES_DB=restorecheck \
  {{ backup_tonem_restore_check_image | quote }} >/dev/null

attempt=0
until docker exec "${container}" pg_isready -U restorecheck -d restorecheck >/dev/null 2>&1; do
  attempt=$((attempt + 1))
  [ "${attempt}" -lt 30 ] || exit 1
  sleep 2
done

docker cp "${dump}" "${container}:/tmp/tonem.dump"
docker exec "${container}" pg_restore -U restorecheck -d restorecheck \
  --no-owner --no-privileges /tmp/tonem.dump
table_count="$(docker exec "${container}" psql -U restorecheck -d restorecheck -Atc \
  "select count(*) from information_schema.tables where table_schema = 'public';")"
[ "${table_count}" -gt 0 ]
success=1
