DEEPSEEK_DAILY_LIMIT={{ home_ai_deepseek_daily_limit }}
DEEPSEEK_MAX_TOKENS={{ home_ai_deepseek_max_tokens }}
DEEPSEEK_BASE_URL={{ home_ai_deepseek_base_url }}
HISTORY_TTL_DAYS={{ home_ai_history_ttl_days }}
