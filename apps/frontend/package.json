      "uuid": "^11.1.1"
    }
  },
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-browser-dynamic": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@ngrx/component-store": "^22.0.0",
    "@ngrx/effects": "^22.0.0",
    "@ngrx/entity": "^22.0.0",
    "@ngrx/router-store": "^22.0.0",
    "@ngrx/store": "^22.0.0",
    "@ngrx/store-devtools": "^22.0.0",
    "@primeuix/themes": "^3.0.0",
    "lodash-es": "^4.17.15",
    "moment": "^2.29.3",
    "ngx-cookie-service": "^22.0.0",
    "ngx-infinite-scroll": "^22.0.0",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^22.1.0",
    "quill": "2.0.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@babel/core": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@ngrx/schematics": "^22.0.0",
    "@types/jasmine": "^6.0.0",
    "@types/lodash-es": "^4.17.5",
    "@types/node": "^24.3.0",
    "angular-eslint": "^22.2.0",
    "eslint": "^10.9.1",
    "eslint-plugin-jasmine": "^4.1.3",
    "globals": "^17.11.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^6.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents": false,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
