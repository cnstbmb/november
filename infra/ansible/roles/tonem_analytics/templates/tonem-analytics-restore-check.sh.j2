#!/bin/sh
set -eu

backup_root={{ tonem_analytics_backup_root | quote }}
metric_dir={{ tonem_analytics_textfile_dir | quote }}
container="tonem-analytics-restore-check"
metric_tmp="${metric_dir}/tonem-analytics-restore-check.prom.tmp"
metric_final="${metric_dir}/tonem-analytics-restore-check.prom"
success=0

finish() {
  docker rm -f "${container}" >/dev/null 2>&1 || true
  mkdir -p "${metric_dir}"
  {
    printf 'tonem_analytics_restore_check_last_run_status %s\n' "${success}"
    if [ "${success}" -eq 1 ]; then
      printf 'tonem_analytics_restore_check_last_success_timestamp_seconds %s\n' "$(date +%s)"
    fi
  } > "${metric_tmp}"
  mv "${metric_tmp}" "${metric_final}"
}
trap finish EXIT INT TERM

dump="$(find "${backup_root}/daily" -maxdepth 1 -type f -name 'umami-*.dump' -print | sort -r | head -n 1)"
test -n "${dump}"
test -s "${dump}"

docker rm -f "${container}" >/dev/null 2>&1 || true
restore_password="$(openssl rand -hex 24)"
docker run -d --name "${container}" --network none \
  -e POSTGRES_USER=restorecheck \
  -e POSTGRES_PASSWORD="${restore_password}" \
  -e POSTGRES_DB=restorecheck \
  {{ tonem_analytics_restore_check_image | quote }} >/dev/null

attempt=0
until docker exec "${container}" pg_isready -U restorecheck -d restorecheck >/dev/null 2>&1; do
  attempt=$((attempt + 1))
  [ "${attempt}" -lt 30 ] || exit 1
  sleep 2
done

docker cp "${dump}" "${container}:/tmp/umami.dump"
docker exec "${container}" pg_restore -U restorecheck -d restorecheck \
  --no-owner --no-privileges /tmp/umami.dump
table_count="$(docker exec "${container}" psql -U restorecheck -d restorecheck -Atc \
  "select count(*) from information_schema.tables where table_schema = 'public';")"
[ "${table_count}" -gt 0 ]
success=1
