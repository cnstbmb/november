# Postgres connection. In production this points at the existing shared
# postgres-db container (service name `postgres-db`) on the `tonem-network`,
# database `tonem`. Create that database first (see deployments/tonem/README.md).
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://november_app:CHANGE_ME@postgres-db:5432/tonem"

# Local dev example (postgres on your machine):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tonem"

# HTTP port the NestJS API + collector listens on.
PORT=3100
