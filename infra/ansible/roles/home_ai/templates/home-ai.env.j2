NODE_ENV=production
DATABASE_PATH=/data/jarvis.sqlite
RKLLM_BASE_URL=http://rkllm:8080/v1
RKLLM_MODEL={{ home_ai_model_name }}
RKLLM_TIMEOUT_MS={{ home_ai_rkllm_request_timeout_seconds | int * 1000 }}
RKLLM_MAX_NEW_TOKENS={{ home_ai_rkllm_max_new_tokens }}
ALLOWED_TELEGRAM_USER_ID={{ home_ai_allowed_telegram_user_id }}
