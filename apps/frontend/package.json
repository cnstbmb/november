{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --serve-path=/",
    "build": "ng build",
    "build:docker:prod": "./tools/scripts/build_prod.sh",
    "build:docker:prod:yc": "./tools/scripts/build_prod_yc.sh",
    "build:docker:local:mac": "./tools/scripts/build_local_mac.sh",
    "build:prod": "ng build --configuration=production --deploy-url=/",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint \"src\"",
    "lint:fix": "eslint \"src\" --fix",
    "test": "ng test"
  },
  "private": true,
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "overrides": {
    "less": "^4.9.0",
